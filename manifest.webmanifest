{
  "name": "Segnavia: diario dei trekking",
  "short_name": "Segnavia",
  "description": "Il tuo diario dei trekking in montagna: tracce, mappe, dislivelli e statistiche.",
  "lang": "it",
  "start_url": "./#diario",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EDEFEA",
  "theme_color": "#EDEFEA",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [{ "action": "./#nuovo", "accept": { "application/gpx+xml": [".gpx"] } }]
}
